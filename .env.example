# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucuda kullanılır (kullanıcı oluşturma, seed). Asla istemciye sızdırmayın.
SUPABASE_SERVICE_ROLE_KEY=

# Çeviri sağlayıcısı: openai | gemini | mock  (boşsa anahtar olana göre seçilir, yoksa mock)
TRANSLATE_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Davet linklerinde kullanılacak genel adres (yayında örn: https://class.line.kg). Boşsa istek adresi kullanılır.
NEXT_PUBLIC_SITE_URL=
