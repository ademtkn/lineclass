# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucuda kullanılır (kullanıcı oluşturma, seed). Asla istemciye sızdırmayın.
SUPABASE_SERVICE_ROLE_KEY=

# Çeviri: anahtarı olan sağlayıcılar sırayla denenir (gemini → deepseek → openai); hiçbiri yoksa demo (mock).
# ÜCRETSİZ öneri: Gemini — https://aistudio.google.com/apikey adresinden kredi kartsız anahtar alın.
TRANSLATE_PROVIDER=
GEMINI_API_KEY=
# GEMINI_MODEL=   (boş bırakın: uygun modeller sırayla denenir)
# DeepSeek ücretsiz değil ama çok ucuz: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Davet linklerinde kullanılacak genel adres (yayında örn: https://class.line.kg). Boşsa istek adresi kullanılır.
NEXT_PUBLIC_SITE_URL=
